# ============================================================
# 南非停电通知 3.0 黑盒/端到端测试配置
# 仅保留执行测试时需要输入或可能切换的值。
# 不知道的值留空；真实 Token、密码只填写到同目录 .env。
# ============================================================

# ---------- 测试版本 ----------
# 测试环境名称，例如 test / uat。
TEST_ENVIRONMENT_NAME=
# 实际部署的版本号、Tag 或 Commit。
TEST_RELEASE_VERSION=
# 实际部署时间，建议格式：2026-08-20 10:00:00。
TEST_RELEASE_TIME=

# ---------- MySQL ----------
# 复用已有 MySQL/SSH 配置，不在本文件重复保存密码或私钥。
MYSQL_CONFIG_PATH=config.json

# ---------- EskomSePush 3.0 ----------
ESKOM_API_BASE_URL=https://developer.sepush.co.za/business/3.0
# 只填写到本地 .env，禁止提交或放入测试报告。
ESKOM_API_TOKEN=
# 当前 Token 的日请求配额，用于控制测试流量。
ESKOM_DAILY_QUOTA=
ESKOM_REQUEST_TIMEOUT_SECONDS=30

# ---------- XXL-JOB ----------
XXL_JOB_CONSOLE_URL=http://139.224.232.119:30002/xxl-job-admin
XXL_JOB_USERNAME=
# 只填写到本地 .env。
XXL_JOB_PASSWORD=

# ---------- 测试电站和设备 ----------
TEST_PLANT_ID=
# plants.block_id 中已有的历史 v2 ID。
TEST_PLANT_BLOCK_ID=
TEST_DEVICE_ID=
# 是否已确认该电站/设备可安全接收通知和执行强充：true / false。
TEST_SAFE_FOR_NOTIFICATION_AND_CHARGE=
